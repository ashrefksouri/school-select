    {
      "order": 5,
      "open": false,
      "question": "Quand l'école a-t-elle été fondée ?",
      "answer_html": "Fondée par <strong>Dr Rached Chebil</strong>, homologuée par le Ministère de l'Éducation le <strong>19 septembre 2017</strong>."
