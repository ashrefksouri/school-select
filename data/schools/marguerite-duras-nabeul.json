  "faq": [
    {
      "order": 1,
      "open": true,
      "question": "Quels sont les frais de scolarité ?",
      "answer_html": "Tier estimé <strong>Premium+ (12-20k TND/an)</strong> selon les comparables AEFE en Tunisie. Grille non publiée."
    },
    {
      "order": 2,
      "open": false,
      "question": "Quel curriculum est enseigné ?",
      "answer_html": "Le <strong>programme officiel du Ministère de l'Éducation Nationale française</strong>, conformément aux standards <strong>AEFE</strong>."
    },
    {
      "order": 3,
      "open": false,
      "question": "Quel est le statut AEFE ?",
      "answer_html": "<strong>Partenaire AEFE</strong>. Le <strong>1er degré (CP-CM2) est homologué</strong> par le Ministère de l'Éducation Nationale française. L'homologation du 2nd degré est en cours."
    },
    {
      "order": 4,
      "open": false,
      "question": "L'école accueille-t-elle dès la maternelle ?",
      "answer_html": "Oui, de la <strong>maternelle (PS-MS-GS)</strong> jusqu'au <strong>lycée (Terminale)</strong>."
    },
    {
      "order": 5,
      "open": false,
      "question": "L'école est-elle reconnue par les autorités tunisiennes ?",
      "answer_html": "Oui. Le <strong>Collège & Lycée Marguerite Duras a obtenu son autorisation officielle en 2025</strong>."
    },
    {
      "order": 6,
      "open": false,
      "question": "Quel diplôme final est préparé ?",
      "answer_html": "Le <strong>Baccalauréat français</strong> et le <strong>DNB (Diplôme National du Brevet)</strong>, équivalents aux diplômes en France."
    },
    {
      "order": 7,
      "open": false,
      "question": "L'école est-elle laïque ?",
      "answer_html": "Oui. C'est un <strong>lycée privé laïque</strong> qui réunit des élèves de nationalité et culture multiples."
    },
    {
      "order": 8,
      "open": false,
      "question": "Qu'est-ce que le projet Tunisie-Pilote II ?",
      "answer_html": "Un projet de coopération éducative franco-tunisien soutenu par l'Ambassade de France en Tunisie, dans le cadre du développement du réseau AEFE."
    },
    {
      "order": 9,
      "open": false,
      "question": "Comment contacter l'admission ?",
      "answer_html": "Téléphone : <strong>+216 29 718 777</strong>. Email : contact@margueriteduras.tn ou secretariat@margueriteduras.tn."
    }
