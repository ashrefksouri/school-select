  "faq": [
    {
      "order": 1,
      "open": true,
      "question": "Quels sont les frais de scolarité ?",
      "answer_html": "Frais non publiés publiquement. Tier estimé <strong>Premium (6-12k TND/an)</strong>. Contact admission recommandé via registration@eistunis.org."
    },
    {
      "order": 2,
      "open": false,
      "question": "Quel curriculum est enseigné ?",
      "answer_html": "Le <strong>British National Curriculum</strong> incluant <strong>EYFS</strong>, <strong>Cambridge Primary</strong>, <strong>Cambridge Lower Secondary</strong> et <strong>Cambridge IGCSE</strong>."
    },
    {
      "order": 3,
      "open": false,
      "question": "Quelle est la tranche d'âge ?",
      "answer_html": "De <strong>3 ans (Nursery) à 16 ans (Year 11)</strong>. Pas de Sixth Form (A Levels) à ce jour."
    },
    {
      "order": 4,
      "open": false,
      "question": "Quel est l'effectif ?",
      "answer_html": "Environ <strong>250 élèves</strong>. <strong>Classes de max 20 élèves</strong>. Ratio <strong>1:8 en Early Years</strong>."
    },
    {
      "order": 5,
      "open": false,
      "question": "Quelles langues sont enseignées ?",
      "answer_html": "<strong>Anglais</strong> est la langue d'enseignement. <strong>Français et arabe</strong> sont enseignés <strong>quotidiennement</strong>."
    },
    {
      "order": 6,
      "open": false,
      "question": "Quel est le profil des enseignants ?",
      "answer_html": "Tous les enseignants principaux sont des <strong>native speakers</strong> avec diplômes, qualifications pédagogiques reconnues et expérience."
    },
    {
      "order": 7,
      "open": false,
      "question": "Qu'est-ce que le Groupe René Descartes ?",
      "answer_html": "Groupe éducatif tunisien <strong>fondé en 1994</strong>. EIST est ouvert en <strong>septembre 2021</strong> comme branche britannique du groupe."
    },
    {
      "order": 8,
      "open": false,
      "question": "Y a-t-il des activités internationales ?",
      "answer_html": "Oui : participation à <strong>HMUN 2026 (Harvard Model United Nations) à Boston</strong>, sorties pédagogiques régulières, assemblées thématiques."
    },
    {
      "order": 9,
      "open": false,
      "question": "Comment s'inscrire ?",
      "answer_html": "Téléphone : <strong>+216 25 904 904</strong>. Email admissions : <strong>registration@eistunis.org</strong>. Email général : contact@eistunis.org."
    }
